# 复制成 .env 后再改：cp .env.example .env
# 注意：.env 里是真实密码，不要提交到 git（已在 .gitignore 里忽略）

# ==================== 数据库 ====================
MYSQL_ROOT_PASSWORD=CHANGE_ME_数据库强密码
MYSQL_DATABASE=fcdzy_site

# ==================== 站点对外地址（必改）====================
# 用来拼接上传图片地址、sitemap 链接；必须写成浏览器能访问到的地址
# 有域名：https://blog.example.com      只有 IP：http://1.2.3.4
SITE_BASE_URL=http://CHANGE_ME
SITE_WEB_URL=http://CHANGE_ME

# ==================== 登录令牌密钥（必改）====================
# 至少 32 个字符，生成方式：openssl rand -base64 48
SITE_JWT_SECRET=CHANGE_ME_至少32位随机字符串_xxxxxxxxxxxxxxxxxxxxxxxx
SITE_JWT_EXPIRE_HOURS=24

# ============ 首次启动自动创建的管理员（必改）============
# 只在数据库为空时生效；之后改密码请用后台「账号设置」
SITE_ADMIN_USERNAME=admin
SITE_ADMIN_PASSWORD=CHANGE_ME_后台登录密码
SITE_ADMIN_NICKNAME=站长

# ==================== 其他 ====================
HTTP_PORT=80
HTTPS_PORT=443
# 后端 JVM 最大堆；2C4G 机器用 512m，2C2G 建议 384m
BACKEND_MAX_HEAP=512m
TZ=Asia/Shanghai
